# ─── Guesty Open API credentials ──────────────────────────────────────────
#
# Create a Guesty Open API integration at app.guesty.com → Integrations → API
# (NOT a Booking Engine integration — different scope).
#
# Token endpoint enforces 3 issuances per 24h per client_id, so a secondary
# pair gives you failover headroom across server restarts. Tokens are disk-
# cached in os.tmpdir() to survive restarts.
GUESTY_OPEN_API_CLIENT_ID=
GUESTY_OPEN_API_CLIENT_SECRET=

# Optional secondary credential pair for failover.
GUESTY_OPEN_API_CLIENT_ID_2=
GUESTY_OPEN_API_CLIENT_SECRET_2=

# Your Guesty account slug as it appears in the merge tag {{guest_app::<slug>}}.
# Usually your account name lowercased with spaces replaced by underscores.
# Example: "FIDUM COMPANY" → "fidum_company"
GUESTY_ACCOUNT_SLUG=fidum_company

# Optional. Disable token disk caching with: GUESTY_TOKEN_CACHE=off
# GUESTY_TOKEN_CACHE=off


# ─── Branding ─────────────────────────────────────────────────────────────
#
# Every NEXT_PUBLIC_* var is optional. Unset = sensible default. All values
# are inlined into the client bundle, so don't put secrets here.

# Identity
#   - SITE_NAME drives the <title>, header chip, and footer.
#   - BRAND_NAME is the company word alone (e.g. "Fidum"), used in the
#     headline as "{Brand} guest portal". If unset, it's auto-derived by
#     stripping a trailing " guest portal" from SITE_NAME.
NEXT_PUBLIC_SITE_NAME=Fidum Guest Portal
NEXT_PUBLIC_BRAND_NAME=Fidum
NEXT_PUBLIC_SITE_URL=https://portal.example.com

# Visuals
#   - NEXT_PUBLIC_LOGO_URL: blank/unset = use the bundled /logo.svg in
#     /public. Set to a path (e.g. /my-logo.svg) or absolute URL to override.
#     Set to "none" to render no logo at all.
#   - NEXT_PUBLIC_FAVICON_URL: defaults to /favicon.svg (a generic house
#     glyph). Drop your own at public/favicon.svg or point this elsewhere.
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_FAVICON_URL=/favicon.svg

# Accent color drives the submit button + focus ring. Hex, rgb(), or any
# CSS color. _INK is the text color drawn on top of the accent.
NEXT_PUBLIC_ACCENT_COLOR=#111111
NEXT_PUBLIC_ACCENT_HOVER_COLOR=#000000
NEXT_PUBLIC_ACCENT_INK=#ffffff

# Copy
NEXT_PUBLIC_HEADLINE=Fidum guest portal
NEXT_PUBLIC_SUBHEAD=Enter your reservation code and we'll take you straight to your trip — address, Wi-Fi, door code, and your host's number.
NEXT_PUBLIC_INPUT_LABEL=Reservation code
NEXT_PUBLIC_INPUT_PLACEHOLDER=HMABCD12345
NEXT_PUBLIC_SUBMIT_LABEL=Open my trip
NEXT_PUBLIC_SUBMIT_LOADING_LABEL=Finding your trip…
NEXT_PUBLIC_HELPER_TEXT=Look for it in the booking confirmation from Airbnb, Vrbo, Booking.com, or your host's email.

# Optional. If set, the site-name footer becomes a link to this URL
# (e.g. your main marketing site or a support page).
NEXT_PUBLIC_SUPPORT_URL=
