# Guesty Open API credentials.
#
# Create a Guesty Open API integration at app.guesty.com → Integrations → API
# (NOT a Booking Engine integration — different scope).
#
# Token endpoint enforces 3 issuances per 24h per client_id, so a secondary
# pair gives you failover headroom across server restarts. Tokens are disk-
# cached in os.tmpdir() to survive restarts.
GUESTY_OPEN_API_CLIENT_ID=
GUESTY_OPEN_API_CLIENT_SECRET=

# Optional secondary credential pair for failover.
GUESTY_OPEN_API_CLIENT_ID_2=
GUESTY_OPEN_API_CLIENT_SECRET_2=

# Your Guesty account slug as it appears in the merge tag {{guest_app::<slug>}}.
# Usually your account name lowercased with spaces replaced by underscores.
# Example: "FIDUM COMPANY" → "fidum_company"
#
# Find yours by inspecting any saved reply in Guesty that contains the
# guest-app merge tag, or peek at the URL of an actual sent guest-app email.
GUESTY_ACCOUNT_SLUG=fidum_company

# Optional. Disable token disk caching with: GUESTY_TOKEN_CACHE=off
# GUESTY_TOKEN_CACHE=off
